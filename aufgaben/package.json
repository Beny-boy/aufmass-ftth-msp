{
  "name": "projekt-aufgaben",
  "version": "1.0.0",
  "description": "Projekt-Aufgaben mit Excel-Import und Desktop-Erinnerung",
  "author": "Projekt-Aufgaben",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "de.projektaufgaben.app",
    "productName": "Projekt-Aufgaben",
    "files": ["index.html", "xlsx.full.min.js", "desktop/**"],
    "win": { "target": "nsis", "icon": "desktop/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
